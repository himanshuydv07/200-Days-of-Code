class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int cnt=0;
        int n=nums.size();
            int candi = nums[0];

        for(int i=0;i<n;i++){
            if(candi == nums[i]){
                cnt++;
            }
            else if(candi!= nums[i]){
                cnt--;
            }
            else{
                candi=nums[i+1];
            }
        }
        
        return candi;
    }
};
